  m_Name: 
  m_EditorClassIdentifier: 
  dialouge:
    Name: Dream Car Man
    characterToSpawn: {fileID: 1529366667462550, guid: 35766b28d8e49b145a31be45abb3077c,
      type: 3}
    charTransformSpawnOn: {fileID: 1966487948}
    Sentences:
    - HEY! What are you doing loitering around here?
    - Yes the car is for sale, but I don't have time for kids like you wasting my
      time...
    - I'm looking for a serious buyer.
    - Beautiful car isn't it? It breaks my heart that i have to sell it.
    - But with the family, and with kids on the way, I don't have the time or money.
    - I can tell you like your cars kid. I tell you what... i will cut you a deal.
    - If you can raise $6000 by the end of the month, it's all yours. How does that
      sound?
    - Just drop by when you have the money. Best of luck kid.
    triggerFadeAfterDialouge: 0
    PostDialogueInstructions: Complete some deliveries at the \n pizzeria to save
      some cash!
  DisableDialougeTriggerObj: 1
  FreezePlayer: 1
  PostDialougeTrigger: {fileID: 1244447325}
  enableSavingsTextPostDia: 0
