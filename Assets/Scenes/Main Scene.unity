        characterToSpawn: {fileID: 1032305250981868, guid: 0774b3aa9983d294e859db07a1f79702,
          type: 3}
        charTransformSpawnOn: {fileID: 553447596}
        Sentences:
        - DONT LISTEN TO A WORD THAT HORRIBLE BOY SAID!!!
        - Everyone in town has been talking about how great you are!
        - When they found out Tony was hiring his son, they were outraged.
