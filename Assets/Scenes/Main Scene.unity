  dialouge:
    Name: Mum
    characterToSpawn: {fileID: 1032305250981868, guid: 0774b3aa9983d294e859db07a1f79702,
      type: 3}
    charTransformSpawnOn: {fileID: 707150766}
    Sentences:
    - You are home late...
    - "Let me guess... out driving again, weren\u2019t you?  "
    - 'And before you even ask,  NO fuel money!  '
    - "One of these days you\u2019re going to hurt yourself, the way you drive...  "
    - 'Anyway, you can''t keep going like this without a job. '
    - "I heard the pizza shop\u2019s hiring delivery drivers. "
    - "Why don\u2019t you go see if they\u2019ll take you?"
    - Since you love driving so much...
    - Good luck son and please try and drive like a normal person.
    triggerFadeAfterDialouge: 1
    PostDialogueInstructions: 
  DisableDialougeTriggerObj: 0
  FreezePlayer: 0
  PostDialougeTrigger: {fileID: 0}
  enableSavingsTextPostDia: 0
