    - type: 3
      Description: 
      pointToReach: {fileID: 0}
      valueToReach: 0
      dialouge:
        Name: Tony Mozarella
        characterToSpawn: {fileID: 0}
        charTransformSpawnOn: {fileID: 0}
        Sentences:
        - "\u201CKid\u2026 you\u2019ve done a lot for this place. More than I could\u2019ve
          asked for. But\u2026"
        - Things are changing around here...
        - My hands are tied and I wish things were different...
        - Im sorry kid but... today is your last day...
        triggerFadeAfterDialouge: 1
        PostDialogueInstructions: 
      pizzasToDeliver: 0
      timeToDeliver: 0
      Cutscene: {fileID: 0}
      variableToSet: 0
      valueToSet: 0
      allowedTime: 0
    - type: 4
      Description: 
      pointToReach: {fileID: 0}
      valueToReach: 0
      dialouge:
        Name: 'Tony''s Son '
        characterToSpawn: {fileID: 0}
        charTransformSpawnOn: {fileID: 0}
        Sentences:
        - "Well, well, look who\u2019s out of a job! Guess dad finally realised this
          place deserves real talent."
        - "Don\u2019t take it too hard, you were always just the warm-up act before
          I the main show."
        - "Oh, and thanks for saving up for that car. Looks great in my driveway.
          Maybe if you\u2019re lucky, I\u2019ll give you a ride sometime!"
        - 'Hasta la vista, loser... '
        triggerFadeAfterDialouge: 1
        PostDialogueInstructions: 
      pizzasToDeliver: 10
      timeToDeliver: 120
      Cutscene: {fileID: 0}
      variableToSet: 0
      valueToSet: 0
      allowedTime: 0
